# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=math_grading
DATABASE_URL=postgresql://admin:adminpassword@postgres-db:5432/math_grading?schema=public

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=adminpassword
RABBITMQ_URL=amqp://admin:adminpassword@rabbitmq:5672

# Object Storage / AWS S3 Configuration
# For AWS S3: leave S3_ENDPOINT and S3_EXTERNAL_ENDPOINT empty
# For Cloudflare R2 / Custom S3: set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_EXTERNAL_ENDPOINT=
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=math-grading
AWS_REGION=ap-southeast-1

# JWT Configuration (Change this to a strong random key in production)
JWT_SECRET=gradingsystemsupersecretkey2026!
