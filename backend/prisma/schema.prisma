datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  GRADING   // Giáo viên đã bấm chấm, đang chờ AI worker trả kết quả
  GRADED    // Đã công bố điểm (publishEvaluation)
}

enum AppealStatus {
  OPEN      // Học sinh vừa gửi, chờ giáo viên trả lời
  RESOLVED  // Giáo viên đã trả lời / xử lý xong
}

enum TranscriptStatus {
  PENDING     // Chưa chép (chỉ chép khi giáo viên bấm chấm)
  PROCESSING  // Đang gọi Gemini chép bài
  COMPLETED
  FAILED
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  password    String
  name        String
  role        Role
  exams       Exam[]        @relation("TeacherExams")
  enrollments ExamStudent[]
  submissions Submission[]
  appeals     Appeal[]
}

model Exam {
  id         String        @id @default(uuid())
  title      String
  teacherId  String
  teacher    User          @relation("TeacherExams", fields: [teacherId], references: [id])
  students   ExamStudent[]
  questions  Question[]
}

model ExamStudent {
  examId    String
  studentId String
  exam      Exam   @relation(fields: [examId], references: [id])
  student   User   @relation(fields: [studentId], references: [id])

  @@id([examId, studentId])
}

model Question {
  id          String       @id @default(uuid())
  examId      String
  exam        Exam         @relation(fields: [examId], references: [id])
  name        String       @default("Câu hỏi")
  content     String       // Math Question in LaTeX format
  rubricSteps RubricStep[]
  submissions Submission[]
}

model RubricStep {
  id           String           @id @default(uuid())
  questionId   String
  question     Question         @relation(fields: [questionId], references: [id])
  stepIndex    Int
  latexContent String           // Target calculation/step in LaTeX
  maxScore     Float
  stepEvaluations StepEvaluation[]
  appeals      Appeal[]
}

model Submission {
  id          String           @id @default(uuid())
  studentId   String
  student     User             @relation(fields: [studentId], references: [id])
  questionId  String
  question    Question         @relation(fields: [questionId], references: [id])
  imageUrl    String?          // S3 Key or S3 URL
  ocrStatus   OcrStatus        @default(PENDING)
  ocrContent  String?          // Text / LaTeX parsed from OCR
  ocrBboxes   Json?            // Array of bounding box objects
  // Bài chép theo vùng bằng Gemini: { image_url, regions: [{box_id, bbox, type, latex, unclear}],
  // unboxed, model, usage, createdAt } hoặc { image_url, error_message } khi lỗi.
  // Chỉ dùng lại (cache) khi image_url trùng imageUrl hiện tại.
  transcript       Json?
  transcriptStatus TranscriptStatus @default(PENDING)
  status      SubmissionStatus @default(NOT_SUBMITTED)
  isPublished Boolean          @default(false)
  submittedAt DateTime?
  evaluation  Evaluation?
  appeals     Appeal[]
}

model Evaluation {
  id                  String           @id @default(uuid())
  submissionId        String           @unique
  submission          Submission       @relation(fields: [submissionId], references: [id])
  totalScore          Float
  isTeacherOverridden Boolean          @default(false)
  stepEvaluations     StepEvaluation[]
}

model StepEvaluation {
  id                String     @id @default(uuid())
  evaluationId      String
  evaluation        Evaluation @relation(fields: [evaluationId], references: [id])
  rubricStepId      String
  rubricStep        RubricStep @relation(fields: [rubricStepId], references: [id])
  isMarkedIncorrect Boolean    // True if student made an error here
  aiReasoning       String     // Explanation from the grading worker
  teacherFeedback   String?    // Optional manual correction explanation
}

// Phản ánh (thắc mắc) của học sinh về kết quả chấm một câu hỏi / một ý chấm
model Appeal {
  id           String       @id @default(uuid())
  submissionId String
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  studentId    String
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rubricStepId String?      // null = phản ánh chung cho cả câu
  rubricStep   RubricStep?  @relation(fields: [rubricStepId], references: [id], onDelete: SetNull)
  stepLabel    String?      // Ảnh chụp nội dung ý chấm lúc gửi, giữ lại nếu barem bị sửa/xóa
  content      String
  status       AppealStatus @default(OPEN)
  teacherReply String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
}
